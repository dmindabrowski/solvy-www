---
import oferta from '../data/oferta.json';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const { firma } = oferta;
// While working locally the link leads to the panel running on this computer.
const panelUrl = import.meta.env.DEV ? 'http://127.0.0.1:8000' : firma.panelUrl;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The preview on GitHub Pages lives in a subfolder, the final site at the root of its domain; `base` covers both.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The preview is a working copy, so search engines are asked to stay away from it.
const podglad = Astro.site?.hostname.endsWith('github.io');

const schema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: firma.nazwa,
	legalName: firma.nazwaPelna,
	url: Astro.site,
	email: firma.email,
	description: firma.opis,
	logo: new URL(`${base}/apple-touch-icon.png`, Astro.site),
	areaServed: 'PL',
	address: {
		'@type': 'PostalAddress',
		streetAddress: firma.adres.ulica,
		postalCode: firma.adres.kod,
		addressLocality: firma.adres.miasto,
		addressCountry: 'PL',
	},
};
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{podglad && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />

		<script is:inline>
			// A theme chosen with the switch is applied before the page paints; without one the system setting decides.
			(() => {
				try {
					const theme = localStorage.getItem('theme');

					if (theme === 'dark' || theme === 'light') {
						document.documentElement.dataset.theme = theme;
					}
				} catch {}

				// Entrance animations hide things first, so they are switched on only when a script runs
				// and the visitor has not asked for less motion.
				if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
					document.documentElement.classList.add('js');
				}
			})();
		</script>

		<link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32" />
		<link rel="icon" href={`${base}/favicon-96.png`} type="image/png" sizes="96x96" />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<link rel="preload" href={`${base}/fonts/inter.woff2`} as="font" type="font/woff2" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:site_name" content={firma.nazwa} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(`${base}/og.png`, Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body>
		<a class="skip-link" href="#tresc">Przejdź do treści</a>

		<header class="top">
			<div class="wrap top__row">
				<a class="brand" href={`${base}/`} aria-label={`${firma.nazwa}, strona główna`}>
					<svg class="brand__mark" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
						<defs>
							<linearGradient id="brand-gradient" x1="0" y1="0" x2="1" y2="1">
								<stop offset="0" stop-color="#38bdf8"></stop>
								<stop offset="1" stop-color="#1d4ed8"></stop>
							</linearGradient>
						</defs>
						<path d="M28 8c2 15 9 22 24 24-15 2-22 9-24 24-2-15-9-22-24-24 15-2 22-9 24-24z" fill="url(#brand-gradient)"></path>
						<path d="M50 6c.8 5 3 7.2 8 8-5 .8-7.2 3-8 8-.8-5-3-7.2-8-8 5-.8 7.2-3 8-8z" fill="#60a5fa"></path>
					</svg>
					<span>{firma.nazwa}</span>
				</a>

				<nav class="top__nav" aria-label="Główne menu">
					<a href="#realizacje">Realizacje</a>
					<a href="#wspolpraca">Współpraca</a>
					<a href="#cennik">Cennik</a>
					<a href="#pytania">Pytania</a>
				</nav>

				<div class="top__actions">
					{panelUrl && (
						<a class="top__link top__link--panel" href={panelUrl} aria-label="Panel klienta">
							<Icon name="user" size={18} /> <span>Panel klienta</span>
						</a>
					)}
					<a class="cta cta--small" href={`${base}/#kontakt`}>
						Napisz do nas
						<span class="cta__arrow"><Icon name="arrow-right" size={15} /></span>
					</a>
					<button type="button" class="theme-toggle" data-theme-toggle aria-label="Przełącz motyw jasny i ciemny" title="Przełącz motyw jasny i ciemny">
						<Icon name="contrast" size={18} />
					</button>
				</div>
			</div>
		</header>

		<nav class="subnav" aria-label="Sekcje strony">
			<div class="wrap">
				<a href="#realizacje">Realizacje</a>
				<a href="#wspolpraca">Współpraca</a>
				<a href="#cennik">Cennik</a>
				<a href="#pytania">Pytania</a>
				<a href="#kontakt">Kontakt</a>
			</div>
		</nav>

		<main id="tresc">
			<slot />
		</main>

		<footer class="foot">
			<div class="wrap foot__row">
				<address class="foot__company">
					<span>© {new Date().getFullYear()} {firma.nazwaPelna}</span>
					<span>
						{firma.adres.ulica}, {firma.adres.kod} {firma.adres.miasto}
					</span>
					<span>NIP {firma.nip}</span>
				</address>
				<a href={`mailto:${firma.email}`}>{firma.email}</a>
			</div>
		</footer>

		<script is:inline>
			(() => {
				const root = document.documentElement;

				document.querySelector('[data-theme-toggle]').addEventListener('click', () => {
					const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
					const next = current === 'dark' ? 'light' : 'dark';

					root.dataset.theme = next;

					try {
						localStorage.setItem('theme', next);
					} catch {}
				});
			})();
		</script>
	</body>
</html>
